<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Product identity -->
    <Product>TSQ Bot</Product>
    <Company>TSQ Bot</Company>
    <Description>Modular Discord bot with esports match tracking and extensible server modules.</Description>
    <RepositoryUrl>https://github.com/Torokal/TSQ-Bot</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (C) 2026 TSQ Bot contributors. Licensed under AGPL-3.0-only.</Copyright>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
    <!-- Git commit is embedded into AssemblyInformationalVersion (+sha) by the .NET SDK SourceLink support
         when building inside a git checkout; see docs/adr/0003-license-and-source.md -->
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SourceRevisionId)' == ''">
    <SourceRevisionId Condition="'$(TOROSQUAD_SOURCE_REVISION)' != ''">$(TOROSQUAD_SOURCE_REVISION)</SourceRevisionId>
  </PropertyGroup>
</Project>
