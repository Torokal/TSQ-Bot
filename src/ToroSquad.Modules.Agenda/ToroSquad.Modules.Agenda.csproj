<Project Sdk="Microsoft.NET.Sdk">

  <!-- TSQ Ajanda: /ajanda and /gundem — a read-only programme view over what other modules already hold, through the Core
       IAgendaSource contract (each source module implements it in its own project). Stateless: no tables, no migration, no
       background job, no provider call, no configuration. Depends on the shared TSQ layers only (never on another feature
       module). The Application namespace must not use the Discord SDK (architecture tests). -->
  <ItemGroup>
    <ProjectReference Include="..\ToroSquad.Core\ToroSquad.Core.csproj" />
    <ProjectReference Include="..\ToroSquad.Discord\ToroSquad.Discord.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="ToroSquad.Modules.Agenda.Localization.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
