<Project Sdk="Microsoft.NET.Sdk">

  <!-- Esports (CS2) module. Domain/Providers/Application namespaces must not use the Discord SDK (architecture tests);
       only the Commands namespace talks to Discord.Net. -->
  <ItemGroup>
    <ProjectReference Include="..\ToroSquad.Core\ToroSquad.Core.csproj" />
    <ProjectReference Include="..\ToroSquad.Infrastructure\ToroSquad.Infrastructure.csproj" />
    <ProjectReference Include="..\ToroSquad.Discord\ToroSquad.Discord.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="ToroSquad.Modules.Esports.Localization.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fixtures\*" LogicalName="ToroSquad.Modules.Esports.Fixtures.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
