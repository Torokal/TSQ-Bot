<Project Sdk="Microsoft.NET.Sdk">

  <!-- TSQ Saat Dönüştürücü: /saat — a time of day in Türkiye (Europe/Istanbul, today) shown in a few other time zones and as
       one Discord timestamp. Real IANA zone data from the OS (TimeZoneInfo; DST automatic), never a fixed UTC offset.
       Stateless: no tables, no migration, no background jobs, no HTTP, no configuration. Depends on the shared TSQ layers
       only (never on another feature module). The Application namespace must not use the Discord SDK (architecture tests);
       only Commands talks to Discord.Net. -->
  <ItemGroup>
    <ProjectReference Include="..\ToroSquad.Core\ToroSquad.Core.csproj" />
    <ProjectReference Include="..\ToroSquad.Discord\ToroSquad.Discord.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="ToroSquad.Modules.Timezone.Localization.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
