{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "Bot": {
    "DataDirectory": "data",
    "SourceUrl": "https://github.com/Torokal/TSQ-Bot",
    "OperatorContact": null,
    "GuildDataRetentionDays": 30,
    "Backup": { "Enabled": true, "IntervalHours": 24, "Keep": 7 }
  },

  "Discord": {
    "Transport": "Fake",
    "ApplicationId": 0,
    "TestGuildIds": [],
    "CommandSyncGuildIds": [],
    "AllowGlobalCommandSync": false
  },

  "Delivery": {
    "Mode": "DryRun",
    "PollInterval": "00:00:05",
    "MaxAttempts": 5
  },

  "Esports": {
    "Provider": { "Name": "PandaScore", "Mode": "Fixture" },
    "MatchPollMinutes": 5,
    "EventPollHours": 6,
    "RankingPollHours": 12,
    "StaleAfterMinutes": 30,
    "ResultCatchUpHours": 6,
    "TeamAliases": {},
    "VerifiedMatchLinks": [],
    "HltvLinksFromLiquipedia": true,
    "HltvLinksFromWikiApi": true,
    "LinkPollMinutes": 30,
    "HltvLinkToleranceMinutes": 90,
    "RescheduleThresholdMinutes": 15,
    "LifecycleFreshMinutes": 90,
    "Liquipedia": {
      "BaseUrl": "https://api.liquipedia.net/api/v3/",
      "Wiki": "counterstrike",
      "UserAgent": null,
      "RequestsPerHour": 60,
      "BudgetShare": 0.8,
      "PageSize": 200,
      "MaxPages": 5
    },
    "Valve": {
      "UserAgent": "TSQBot"
    }
  },

  "PandaScore": {
    "BaseUrl": "https://api.pandascore.co/",
    "Game": "csgo",
    "RequestsPerHour": 1000,
    "BudgetShare": 0.5,
    "PageSize": 100,
    "MaxPages": 5
  },

  "Formula1": {
    "Provider": { "Mode": "Fixture", "Schedule": "Jolpica", "Lifecycle": "OpenF1", "Results": "OpenF1", "Standings": "Jolpica" },
    "ScheduleRefreshHours": 6,
    "StandingsRefreshHours": 6,
    "StartFreshMinutes": 10,
    "ResultCorrectionHours": 24,
    "ResultCatchUpHours": 6,
    "StandingsSettleWindowMinutes": 180,
    "Jolpica": {
      "BaseUrl": "https://api.jolpi.ca/ergast/f1/",
      "RequestsPerHour": 500,
      "BurstPerSecond": 4,
      "BudgetShare": 0.5
    },
    "OpenF1": {
      "BaseUrl": "https://api.openf1.org/",
      "TokenUrl": "https://api.openf1.org/token",
      "MqttHost": "mqtt.openf1.org",
      "MqttPort": 8883,
      "RequestsPerMinute": 30,
      "RequestsPerSecond": 3,
      "BudgetShare": 0.5
    }
  },

  "Volleyball": {
    "Provider": { "Mode": "Fixture", "Name": "FivbVis" },
    "FixtureRefreshHours": 6,
    "FixtureRefreshNearMinutes": 60,
    "LiveLeadMinutes": 30,
    "LivePollSeconds": 60,
    "ContinuityMinutes": 10,
    "ReminderLeadMinutes": 15,
    "LiveFreshMinutes": 15,
    "ResultCatchUpHours": 6,
    "Fivb": {
      "BaseUrl": "https://www.fivb.org/Vis2009/",
      "AppId": null,
      "RequestsPerMinute": 10
    }
  },

  "Live": {
    "Enabled": false,
    "DiscordChannelId": 0,
    "GuildId": 0,
    "ReconciliationIntervalSeconds": 30,
    "ReconnectGraceSeconds": 120,
    "AnnounceExistingLiveOnBootstrap": false,
    "AnnouncementMaxDelayMinutes": 15,
    "Creators": {
      "lordtoro": { "DisplayName": "LORDTORO", "Twitch": "lordtoro", "Kick": "lordtoro" },
      "nasilyani69": { "DisplayName": "NASILYANI69", "Twitch": "nasilyani69", "Kick": "nasilyani69" }
    },
    "Twitch": {
      "ApiBaseUrl": "https://api.twitch.tv/helix/",
      "TokenUrl": "https://id.twitch.tv/oauth2/token",
      "ValidateUrl": "https://id.twitch.tv/oauth2/validate"
    },
    "Kick": {
      "ApiBaseUrl": "https://api.kick.com/public/v1/",
      "TokenUrl": "https://id.kick.com/oauth/token"
    }
  },

  "Modules": {
    "Example": { "Enabled": false }
  }
