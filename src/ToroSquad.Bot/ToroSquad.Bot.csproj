<Project Sdk="Microsoft.NET.Sdk">

  <!-- Composition root: the only project that knows every module. Also hosts EF migrations and the CLI verbs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ToroSquad.Bot</AssemblyName>
    <UserSecretsId>torosquad-bot-local-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ToroSquad.Core\ToroSquad.Core.csproj" />
    <ProjectReference Include="..\ToroSquad.Infrastructure\ToroSquad.Infrastructure.csproj" />
    <ProjectReference Include="..\ToroSquad.Discord\ToroSquad.Discord.csproj" />
    <ProjectReference Include="..\ToroSquad.Modules.Esports\ToroSquad.Modules.Esports.csproj" />
    <ProjectReference Include="..\ToroSquad.Modules.Example\ToroSquad.Modules.Example.csproj" />
    <ProjectReference Include="..\ToroSquad.Modules.Formula1\ToroSquad.Modules.Formula1.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
