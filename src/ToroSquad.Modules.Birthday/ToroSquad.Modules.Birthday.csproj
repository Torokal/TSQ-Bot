<Project Sdk="Microsoft.NET.Sdk">

  <!-- TSQ Birthday (Doğum Günü): members register day + month (never a year); the bot celebrates them at the start of the
       day in the configured time zone and gives a temporary role for that day. Depends on the shared TSQ layers only (never
       on another feature module). Domain/Application/Persistence namespaces must not use the Discord SDK (architecture
       tests); only Commands talks to Discord.Net. -->
  <ItemGroup>
    <ProjectReference Include="..\ToroSquad.Core\ToroSquad.Core.csproj" />
    <ProjectReference Include="..\ToroSquad.Infrastructure\ToroSquad.Infrastructure.csproj" />
    <ProjectReference Include="..\ToroSquad.Discord\ToroSquad.Discord.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="ToroSquad.Modules.Birthday.Localization.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
