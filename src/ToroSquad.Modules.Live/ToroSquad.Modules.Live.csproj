<Project Sdk="Microsoft.NET.Sdk">

  <!-- TSQ Live: Twitch + Kick live-stream announcements for a fixed, configured set of creators. Depends on the shared
       TSQ layers only (never on another feature module). Domain/Providers/Application/Persistence namespaces must not use
       the Discord SDK (architecture tests); only Commands talks to Discord.Net. -->
  <ItemGroup>
    <ProjectReference Include="..\ToroSquad.Core\ToroSquad.Core.csproj" />
    <ProjectReference Include="..\ToroSquad.Infrastructure\ToroSquad.Infrastructure.csproj" />
    <ProjectReference Include="..\ToroSquad.Discord\ToroSquad.Discord.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="ToroSquad.Modules.Live.Localization.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
