<Project Sdk="Microsoft.NET.Sdk">

  <!-- TSQ Döviz & Altın: /dolar, /euro and /altın answer the current USD/TRY, EUR/TRY and gram gold buy/sell prices,
       fetched on demand from public provider feeds (no API key) and cached in memory. Stateless: no tables, no background
       jobs. Depends on the shared TSQ layers only (never on another feature module). The Domain, Providers and Application
       namespaces must not use the Discord SDK (architecture tests); only Commands talks to Discord.Net. -->
  <ItemGroup>
    <ProjectReference Include="..\ToroSquad.Core\ToroSquad.Core.csproj" />
    <ProjectReference Include="..\ToroSquad.Discord\ToroSquad.Discord.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="ToroSquad.Modules.Currency.Localization.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
