<Project Sdk="Microsoft.NET.Sdk">

  <!-- Discord: interaction infrastructure, command manifest/sync, transports, core slash commands.
       References Core only (never Infrastructure or feature modules). -->
  <ItemGroup>
    <ProjectReference Include="..\ToroSquad.Core\ToroSquad.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net.Interactions" />
    <PackageReference Include="Discord.Net.WebSocket" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="ToroSquad.Discord.Localization.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
